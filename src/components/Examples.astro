---
import { Picture } from 'astro:assets';
import BrowserFrame from './BrowserFrame.astro';
import SectionHeading from './SectionHeading.astro';
import { getContent } from '../i18n';
import vitrine from '../assets/examples/vitrine.png';
import portfolio from '../assets/examples/portfolio.png';
import cabinet from '../assets/examples/cabinet.png';

// TODO(owner): remplacer ces 3 images par de vraies captures d'écran
// (même nom de fichier, idéalement 1600x1000 px).
const images = { vitrine, portfolio, cabinet };
const { examples, ui } = getContent(Astro.url);
---
<section id="exemples" class="section" aria-labelledby="exemples-titre">
  <div class="container-page">
    <SectionHeading id="exemples-titre" eyebrow={examples.eyebrow} title={examples.title} />
    <ul class="mt-12 grid gap-14 md:mt-16 md:gap-20">
      {examples.items.map((ex, i) => (
        <li class:list={['reveal md:w-[88%]', i % 2 === 1 && 'md:ml-auto']}>
          <figure class="zoom">
            <BrowserFrame url={ex.url} class="lift">
              <Picture
                src={images[ex.image]}
                formats={['avif', 'webp']}
                widths={[480, 800, 1200, 1600]}
                sizes="(min-width: 1216px) 1070px, (min-width: 768px) 88vw, 100vw"
                alt={ui.exampleAlt(ex.name, ex.plan)}
                class="block h-auto w-full"
                loading="lazy"
                decoding="async"
              />
            </BrowserFrame>
            <figcaption class="mt-5 flex flex-wrap items-baseline gap-x-4 gap-y-2">
              <span class="font-display text-3xl">{ex.plan}</span>
              <span class="text-muted">{ex.name}</span>
              <span class="rounded-full border border-line px-3 py-0.5 text-[0.8125rem] text-muted">{examples.tag}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

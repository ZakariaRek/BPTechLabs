---
// Mobile only: a round WhatsApp button that stays bottom-right.
import Icon from './Icon.astro';
import { getContent } from '../i18n';
const { contact, ui } = getContent(Astro.url);
---
<a
  href={contact.whatsappUrl}
  target="_blank"
  rel="noopener"
  data-track="whatsapp"
  data-placement="floating"
  aria-label={`${contact.whatsappLabel} ${ui.newTab}`}
  class="floating fab fixed z-40 inline-flex size-14 items-center justify-center rounded-full bg-accent text-white shadow-[0_10px_30px_-8px_rgb(20_63_58/0.55)] transition-colors hover:bg-accent-strong md:hidden"
>
  <Icon name="message" size={24} />
</a>

<style>
  .floating {
    right: calc(1rem + env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));
  }
</style>

---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { getContent } from '../i18n';
const { maintenance } = getContent(Astro.url);
---
<section class="section" aria-labelledby="maintenance-titre">
  <div class="container-page">
    <SectionHeading id="maintenance-titre" eyebrow={maintenance.eyebrow} title={maintenance.title} />

    <ul class="mt-12 grid gap-6 md:mt-16 md:grid-cols-2 lg:gap-8">
      {maintenance.plans.map((p, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <div class="lift flex h-full flex-col rounded-2xl border border-line bg-card p-6 sm:p-8">
            <p class="flex flex-wrap items-baseline gap-x-2">
              <span class="tabular font-display text-5xl leading-none">{p.price}</span>
              <span class="text-[0.9375rem] font-medium text-muted">{maintenance.priceUnit}</span>
            </p>
            <p class="mt-4 text-lg font-semibold">{p.frequency}</p>
            <ul class="mt-6 grid gap-3 border-t border-line pt-6">
              {maintenance.included.map((f) => (
                <li class="flex gap-3">
                  <Icon name="check" size={18} class="mt-1 shrink-0 text-accent" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <p class="tabular mt-6 rounded-lg bg-paper-2 px-4 py-3 text-[0.9375rem]">{p.yearly}</p>
          </div>
        </li>
      ))}
    </ul>

    <p class="reveal mt-8 max-w-2xl text-muted">{maintenance.note}</p>
  </div>
</section>

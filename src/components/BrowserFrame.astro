---
interface Props {
  url: string;
  class?: string;
}
const { url, class: className = '' } = Astro.props;
---
<div
  class:list={[
    'overflow-hidden rounded-xl border border-line bg-card shadow-[0_30px_60px_-30px_rgb(31_33_30/0.35)]',
    className,
  ]}
>
  <div class="flex items-center gap-3 border-b border-line bg-paper-2 px-3.5 py-2.5" aria-hidden="true">
    <span class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-[#cfccc2]"></span>
      <span class="size-2.5 rounded-full bg-[#cfccc2]"></span>
      <span class="size-2.5 rounded-full bg-[#cfccc2]"></span>
    </span>
    <span class="mx-auto flex min-w-0 max-w-[16rem] flex-1 items-center justify-center truncate rounded-md bg-card px-3 py-1 text-[0.75rem] text-muted">
      {url}
    </span>
    <span class="w-[2.625rem]"></span>
  </div>
  <slot />
</div>

---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import { alternates, defaultLang, getContent } from '../i18n';

const { contact, meta, ui } = getContent(Astro.url);
const ogImage = new URL(meta.ogImage, Astro.site).href;
const defaultHref = alternates.find((a) => a.lang === defaultLang)!.href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: meta.brand,
  url: contact.siteUrl,
  description: meta.description,
  telephone: contact.phoneE164,
  image: ogImage,
  areaServed: { '@type': 'Country', name: 'Morocco' },
  priceRange: '7500–18900 MAD',
  knowsLanguage: ['fr', 'en'],
  inLanguage: ui.lang,
  // TODO(owner): ajouter "address" (adresse postale) et "logo" quand ils existent.
};
---
<!doctype html>
<html lang={ui.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={contact.siteUrl} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <meta name="theme-color" content="#f5f4ef" />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />

    <!-- TODO(owner): remplacer le favicon provisoire (public/favicon.svg) par le logo. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ui.ogLocale} />
    {alternates.filter((a) => a.lang !== ui.lang).map((a) => (
      <meta property="og:locale:alternate" content={a.lang === 'fr' ? 'fr_MA' : 'en_US'} />
    ))}
    <meta property="og:site_name" content={meta.brand} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={contact.siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={meta.ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!--
      Mesure d'audience (optionnelle, respectueuse de la vie privée).
      Aucun outil n'est installé. Pour en ajouter un (Plausible, Umami,
      Cloudflare Web Analytics...), collez son script ici.
      Chaque bouton WhatsApp porte data-track="whatsapp" et data-placement="..."
      pour compter les clics.
    -->
  </head>
  <body>
    <slot />
  </body>
</html>
